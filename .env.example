# ============================================================
#  nonebot_chat 环境变量示例
# ============================================================
#  复制此文件为 .env 并修改其中的值。
#  NoneBot 会自动加载 bot 项目根目录下的 .env 文件。
#
#  环境变量只负责「顶层开关 + 配置路径 + API Key」，
#  人格、模型、温度、记忆等详细配置在 chat_config.yaml 中，
#  详见 README「配置」章节。
# ============================================================

# chat_config.yaml 配置文件路径（可选）
# 不设置时，插件默认在「插件安装目录」下查找 chat_config.yaml：
#   - git clone / 源码方式 → plugins/nonebot_chat/chat_config.yaml（仓库自带）
#   - pip / uv 安装 → 通常找不到，需通过 CHAT_CONFIG_PATH 指定
# 找不到配置文件时，插件以内置默认值启动（仅开发调试用）。
# CHAT_CONFIG_PATH=chat_config.yaml

# 是否仅允许超级用户使用聊天功能
# 默认 true（仅超管可用）。设为 false 则所有人可用。
CHAT_ONLY_SUPERUSERS=true

# 是否启用聊天功能
CHAT_CHAT_ENABLED=true

# LLM API Key（可选，兼容任意 OpenAI 兼容服务）
# 支持：OpenAI 官方、Ollama、vLLM、LM Studio、DeepSeek 等任何
# 实现了 /v1/chat/completions 接口的服务。
# 本地服务（如 Ollama）通常无需认证，可留空。
# LLM_API_KEY=sk-...
