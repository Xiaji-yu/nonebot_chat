# ============================================================
#  nonebot_chat 环境变量示例
# ============================================================
#  复制此文件为 .env 并修改其中的值。
#  NoneBot 会自动加载 .env 文件。
# ============================================================

# 是否仅允许超级用户使用聊天功能
CHAT_ONLY_SUPERUSERS=true

# 是否启用聊天功能
CHAT_CHAT_ENABLED=true

# LLM API Key（可选）
# OpenAI 官方：https://api.openai.com/v1
# OPENAI_API_KEY=sk-...

# 通用 LLM API Key（可选，回退到 OPENAI_API_KEY）
# LLM_API_KEY=...
